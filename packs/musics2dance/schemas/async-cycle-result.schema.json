{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "experiment_id",
    "job_ids",
    "github_comment_url",
    "github_comment_path",
    "launch_request_path",
    "stage_closure",
    "next_action"
  ],
  "properties": {
    "status": {
      "enum": ["active", "launch_ready", "waiting_jobs", "needs_web", "completed", "blocked"]
    },
    "summary": {"type": "string", "minLength": 1},
    "experiment_id": {"type": ["string", "null"]},
    "job_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[0-9]+$"}
    },
    "github_comment_url": {"type": ["string", "null"]},
    "github_comment_path": {"type": ["string", "null"]},
    "launch_request_path": {"type": ["string", "null"]},
    "stage_closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared", "completed", "remaining", "evidence"],
      "properties": {
        "declared": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}
        },
        "completed": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}
        },
        "remaining": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stage", "paths"],
            "properties": {
              "stage": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
              "paths": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "next_action": {"type": "string", "minLength": 1}
  }
}
